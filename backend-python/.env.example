LLM_PROVIDER=openai            # openai | gemini | groq | anthropic (default LLM for chat and RAG when request omits provider)
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=gm-placeholder
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=gsk-placeholder
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=anthropic-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In development, any localhost/127.0.0.1 port is also allowed (see app/core/cors.py).
APP_ENV=development
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
MAX_MESSAGE_LENGTH=4000
REQUEST_TIMEOUT_SECONDS=30
REQUEST_BODY_LIMIT_BYTES=16384
# HTTP rate limits (requests per minute; health endpoints exempt)
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
# PostgreSQL connection (async driver). Host port 5433 via docker-compose.override.yml.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot
# Google OAuth 2.0 client id used to verify ID tokens (required for /api/auth/google)
GOOGLE_CLIENT_ID=
# App JWT signing (override JWT_SECRET outside local development)
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
# Guest quota: max messages per UTC day for anonymous callers
GUEST_DAILY_MESSAGE_QUOTA=20
# --- V1.1.1 demo protection (Phase 1) ---
# Cap guest completion length (provider max_tokens). Dev default is permissive (4096).
# GUEST_MAX_OUTPUT_TOKENS=4096
# Daily authenticated document upload count (unset = unlimited in dev).
# AUTHENTICATED_DAILY_UPLOAD_QUOTA=20
# Future-proof if guest upload is ever enabled.
# GUEST_DAILY_UPLOAD_QUOTA=5
# Tighten caps for public demo deploy (lowers guest tokens to min(env, 512); upload quota defaults to 20).
# DEMO_MODE_STRICT=false
# Production public demo profile (example):
# DEMO_MODE_STRICT=true
# GUEST_MAX_OUTPUT_TOKENS=512
# AUTHENTICATED_DAILY_UPLOAD_QUOTA=20
# Rate limits (review for production public demo — see docs/ops/public-demo-protection.md)
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
# Feature flag: persist chat sessions/messages/usage (off => stateless chat)
CHAT_PERSISTENCE_ENABLED=true
# --- AI / RAG configuration (Phase 1; optional — safe defaults when omitted) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# Optional: Embedding batch size for document ingestion
# EMBEDDING_BATCH_SIZE=100
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# Parent-child chunking (used when ADVANCED_RAG_ENABLED=true)
# CHILD_CHUNK_SIZE=400
# CHILD_CHUNK_OVERLAP=80
# PARENT_CHUNK_SIZE=2000
# PARENT_CHUNK_OVERLAP=200
# Hybrid retrieval (dense + Postgres FTS fused with RRF; Phase 4)
# HYBRID_DENSE_TOP_K=20
# HYBRID_LEXICAL_TOP_K=20
# RRF_K=60
# Query rewrite (Phase 5; only when ADVANCED_RAG_ENABLED=true)
# QUERY_REWRITE_ENABLED=true
# Cross-encoder rerank (Phase 6; only when ADVANCED_RAG_ENABLED=true)
# COHERE_API_KEY=required when the advanced rerank path runs
# RERANK_PROVIDER=cohere
# RERANK_MODEL=rerank-v3.5
# RERANK_TIMEOUT_MS=1500
# RAG_TOP_K=5
# RAG_DEFAULT_PROMPT_TEMPLATE=rag/answer/v1
# RAG_CONTEXT_MAX_CHARS=8000
# Citation snippet bound (Phase 8; used when advanced path builds citations)
# CITATION_SNIPPET_MAX_CHARS=240
# RAG_ENABLED=false
# Gates document grounding toggle (use_documents on POST /api/chat[/stream]) and POST /api/rag/ask.
# Per-request provider/model override on POST /api/rag/ask and chat (optional provider, model fields).
# When omitted, RAG uses LLM_PROVIDER and the matching default model env var above.
# TOOLS_ENABLED=false
# Gates web search toggle (use_web_search on POST /api/chat[/stream]); registers Tavily web_search tool.
# CHAT_STREAMING_ENABLED=true
# Default true — SSE via POST /api/chat/stream. When false, stream route returns 503; UI uses POST /api/chat.
# Request toggles use_web_search / use_documents are JSON body fields (not env vars); require auth; default false.
# DEFAULT_TEMPERATURE=0.7
# DEFAULT_MAX_TOKENS=
# DOCUMENT_UPLOAD_MAX_BYTES=10485760  # enforced on POST /api/documents/upload (Phase 11)
# WEB_SEARCH_PROVIDER=tavily
# Required when TOOLS_ENABLED=true (Tavily web search)
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# --- V2 Epic 1 agent runtime (Phase 1 / Phase 11) ---
# When true, web-search chat routes through app/ai/agent/ instead of ToolChatService.
# Default off — V1.1 tool loop remains the hot path until explicitly enabled.
AGENT_RUNTIME_ENABLED=false
# --- V2 Epic 2 advanced RAG ---
# Default false. When true:
#   - ingest uses ParentChildChunker (children embedded; parents stored for expand)
#   - chat (use_documents) and POST /api/rag/ask use AdvancedRetrievalPipeline:
#     rewrite → hybrid (dense+FTS+RRF) → filter → parent expand → Cohere rerank
#     → faithful compress → post-compression citations
# When false: V1 dense Retriever → ContextBuilder path (unchanged).
# Set COHERE_API_KEY when enabling advanced RAG if you want cross-encoder rerank
# (missing key falls back to pre-rerank RRF order).
ADVANCED_RAG_ENABLED=false
# --- V2 Epic 3 MCP integration ---
# Default false. Phase 1 scaffolds MCP package (Protocol, models, exceptions).
# Phase 7 adds permission model; Phase 8 adds server registration.
# When fully implemented: connect to MCP servers, discover tools, execute remote
# tool calls via stdio transport. Flag-off keeps V1 local tools unchanged.
MCP_ENABLED=false

# Phase 7: MCP permission policy (per-server/per-tool allowlists).
# Empty dict → all configured servers/tools allowed (default permissive).
# Example (restrictive):
# MCP_PERMISSION_POLICY='{"allowed_servers": ["filesystem", "github"], "allowed_tools": {"filesystem": ["read_file", "list_directory"], "github": ["*"]}}'
# - allowed_servers empty/absent → all servers allowed
# - allowed_tools absent → all tools from allowed servers allowed
# - allowed_tools[server] = ["*"] → all tools from that server allowed
# - allowed_tools[server] = ["tool1"] → only listed tools allowed
MCP_PERMISSION_POLICY={}

# Phase 8: MCP server configurations (JSON array of server configs).
# Each server config requires: name, command, args, env (optional), transport (default stdio).
# Credentials can be passed via env field with ${VAR_NAME} interpolation.
# Example with filesystem and github servers:
# MCP_SERVERS='[
#   {
#     "name": "filesystem",
#     "command": "npx",
#     "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp/mcp-workspace"],
#     "env": {},
#     "transport": "stdio"
#   },
#   {
#     "name": "github",
#     "command": "uvx",
#     "args": ["mcp-server-github"],
#     "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"},
#     "transport": "stdio"
#   }
# ]'
MCP_SERVERS=[]

# Phase 8: MCP connection and tool execution timeouts (seconds).
# Connection timeout applies to server connect and list_tools operations.
# Tool timeout applies to individual tool execution (call_tool).
# MCP_CONNECTION_TIMEOUT_SECONDS=10
# MCP_TOOL_TIMEOUT_SECONDS=30

# --- V2 Epic 4 voice interfaces ---
# Default false. When true: enable voice STT/TTS pipelines, WebSocket voice endpoint
# (/api/voice/ws), and voice mode UI for authenticated users. Flag-off keeps text
# chat SSE unchanged. Voice sessions are authenticated-only (guests denied).
VOICE_ENABLED=false

# Voice provider and model configuration (default: OpenAI Whisper + TTS).
# VOICE_PROVIDER=openai
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy

# Voice audio format and streaming configuration.
# Audio format: PCM16, 24 kHz mono. Max chunk size for inbound/outbound audio.
# VOICE_SAMPLE_RATE_HZ=24000
# VOICE_AUDIO_ENCODING=pcm16
# VOICE_MAX_CHUNK_BYTES=4096

# TTS latency tuning (optional — defaults shown). Lower values start assistant
# audio sooner while the LLM reply is still streaming.
# VOICE_TTS_EARLY_FLUSH_CHARS=40
# VOICE_TTS_TIME_FLUSH_MS=500
# VOICE_TTS_MIN_TIME_FLUSH_CHARS=12

# Voice session lifecycle and timeout configuration.
# Session timeout: idle seconds before auto-close. Heartbeat: client interval.
# Max utterance: seconds before forcing transcript_final.
# VOICE_SESSION_TIMEOUT_SECONDS=300
# VOICE_HEARTBEAT_INTERVAL_SECONDS=30
# VOICE_MAX_UTTERANCE_SECONDS=60

# WebSocket voice protocol (when VOICE_ENABLED=true):
# Connect: GET /api/voice/ws?session_id={chat_session_id} with Bearer JWT.
# JSON message types — session_started, audio_in, transcript_partial/final,
# assistant_text_delta, audio_out, tool_start/tool_end, interrupt/interrupted,
# turn_complete, heartbeat, session_end/session_closed, error.
# Audio payloads: base64-encoded PCM16 24 kHz mono; max chunk size VOICE_MAX_CHUNK_BYTES.

# --- V2 Epic 5 memory system ---
# Default false. Phase 1: registers Memory domain models, provider scaffold,
# DB tables (memory_records, user_preferences), and DI wiring. When true,
# validates memory provider config only; chat retrieval/injection, persistence,
# management API, and Settings UI are not wired until later phases. Flag-off
# keeps chat/RAG/voice/MCP/agent paths unchanged from Epic 04.
MEMORY_ENABLED=false

# Memory provider and retrieval/quality tuning (optional — defaults shown).
# MEMORY_PROVIDER=pgvector
# MEMORY_RETRIEVAL_TOP_K=8
# MEMORY_MIN_QUALITY_SCORE=0.4
# MEMORY_MIN_CONFIDENCE=0.5
# MEMORY_DEDUPE_SIMILARITY_THRESHOLD=0.92
# MEMORY_TOKEN_BUDGET=1500
# MEMORY_EXTRACTION_ENABLED=true
# MEMORY_EXTRACTION_MODEL=
# MEMORY_ARCHIVED_RETENTION_DAYS=90

# --- V2 Epic 6 workflow engine ---
# Default false. Phase 1: registers Workflow domain models, provider scaffold,
# DB tables (workflow_definitions, workflow_runs, workflow_node_executions), and
# DI wiring. When true, validates workflow provider config only; graph validation,
# execution engine, REST API, agent tool, and frontend are not wired until later
# phases. Flag-off keeps chat/RAG/voice/MCP/memory/agent paths unchanged.
WORKFLOW_ENGINE_ENABLED=false

# Workflow provider and execution tuning (optional — defaults shown).
# WORKFLOW_PROVIDER=postgres
# WORKFLOW_MAX_NODES_PER_DEFINITION=50
# WORKFLOW_MAX_PARALLEL_BRANCHES=8
# WORKFLOW_NODE_TIMEOUT_SECONDS=120
# WORKFLOW_MAX_NODE_RETRIES=3
# WORKFLOW_NODE_RETRY_BASE_DELAY_SECONDS=1.0
# WORKFLOW_MAX_RUN_DURATION_MINUTES=60
# WORKFLOW_APPROVAL_TIMEOUT_HOURS=0
# WORKFLOW_RUN_RETENTION_DAYS=90

# --- V2 Epic 7 observability & evaluation ---
# Default false. Phase 1: OTel TracerProvider/MeterProvider bootstrap, span helpers,
# and trace/span-id log correlation. Pipeline instrumentation, cost accounting,
# REST API, and evaluation extensions are not wired until later phases. Flag-off
# keeps all Epic 06 pipeline paths unchanged.
OBSERVABILITY_ENABLED=false

# OpenTelemetry settings (honoured only when OBSERVABILITY_ENABLED=true).
# OTEL_SERVICE_NAME=fullstack-ai-platform
# Empty OTEL_EXPORTER_OTLP_ENDPOINT selects the console span exporter (dev default).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Trace sampling ratio — override per environment:
#   development/local: 1.0 (100%)
#   staging/CI:        0.25 (25%)
#   production:        0.05 (5%)
# OTEL_TRACES_SAMPLE_RATIO=1.0

# Cost accounting (honoured only when OBSERVABILITY_ENABLED=true).
# Rates live in git-tracked config/model_pricing.yaml — not env-overridable.
# OBSERVABILITY_COST_PRICING_FILE=config/model_pricing.yaml
# Must match pricing_version in the pricing file at startup.
# OBSERVABILITY_COST_PRICING_VERSION=2026-08

# --- V2 Epic 8 plugin architecture ---
# Default false. When true: discover plugin.yaml manifests under PLUGIN_DIRECTORIES,
# import entrypoints at startup, and wire tool/prompt/workflow/MCP contributions into
# existing registries. Plugin REST API and frontend inventory page require this flag.
# Flag-off keeps all Epic 07 pipeline paths unchanged.
PLUGINS_ENABLED=false

# Plugin discovery paths (relative to backend-python/ unless absolute).
# Default includes git-tracked reference plugins under plugins/.
PLUGIN_DIRECTORIES=["plugins"]

# Empty allowlist → all discovered plugins load. Non-empty → only listed plugin_ids.
# PLUGIN_ALLOWLIST=[]

# Cooperative loader wait for register(registrar) in a daemon worker thread.
# Does not interrupt in-process plugin code; on wait expiry the plugin is marked
# failed, staging is discarded, and the registrar is closed.
# PLUGIN_REGISTRATION_WAIT_TIMEOUT_SECONDS=30

# --- V2 Epic 9 human-in-the-loop ---
# Default false. When true: flagged tool calls pause for human approval on agent
# and workflow surfaces. REST inbox/decide endpoints and resume wiring require
# this flag. Flag-off keeps all Epic 08 pipeline paths unchanged.
HITL_ENABLED=false

# Operator override: tool names requiring approval even when ToolDefinition.requires_approval
# is false. Union with per-tool flags — either source is sufficient.
# HITL_REQUIRED_TOOL_NAMES=[]

# Documented config surface only; timeout enforcement is deferred (same posture as
# WORKFLOW_APPROVAL_TIMEOUT_HOURS).
# HITL_APPROVAL_TIMEOUT_HOURS=0

# Server-side truncation guard for decision reason text (characters).
# HITL_MAX_REASON_LENGTH=2000
